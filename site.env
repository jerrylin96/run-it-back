# Site-specific paths for the launchers in this repository. Every *.sbatch sources this
# file from the submit directory, and crun sources it from the repo root. Edit once per
# cluster; nothing else in the launchers should need changing.

# The container image built from docker/makani.def (docker/build_makani.sbatch writes it here).
export MAKANI_IMG="/path/to/makani.sif"

# The data root, bind-mounted into the container at the SAME path so the paths in
# config/rewind_fcn3.yaml resolve unchanged. The config's paths assume this default; if
# your data lives elsewhere, set it here AND update the path keys in config/rewind_fcn3.yaml
# (one sed: s#/data/makani_era5_fcn3#/your/root#g).
# Layout: $MAKANI_DATA/{train,train_10yr,valid,test,casestudy,stats,invariants,runs}
export MAKANI_DATA="/data/makani_era5_fcn3"

# Optional: where docker/build_makani.sbatch caches downloaded image layers.
export MAKANI_APPTAINER_CACHE="${MAKANI_APPTAINER_CACHE:-$HOME/.apptainer/cache}"
